<?xml version="1.0" encoding="utf-8"?>
<!-- Fork-only strings. English only: other locales fall back to these. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="MissingTranslation">
    <string name="live_update_channel_name">Live Updates</string>
    <string name="live_update_channel_description">Live progress of a trip that you track</string>

    <string name="live_update_title">%1$s to %2$s</string>
    <string name="live_update_placeholder_title">Live update</string>
    <string name="live_update_placeholder_text">Finding your trip…</string>

    <string name="live_update_text_boarding">Boarding at %1$s</string>
    <string name="live_update_text_arriving">Arriving at %1$s</string>
    <string name="live_update_text_approaching">1 min to %1$s</string>
    <string name="live_update_text_minutes">%1$d min to %2$s</string>
    <string name="live_update_text_clock_time">Arrives at %2$s at %1$s</string>
    <string name="live_update_text_unknown">Waiting for predictions for %1$s</string>

    <!-- Notification title. Keep these short: the title is one line, and a long title hides the stop count. -->
    <string name="live_update_wait_boarding">Boarding now</string>
    <string name="live_update_wait_arriving">Arriving now</string>
    <string name="live_update_short_minutes">%1$d min</string>
    <string name="live_update_wait_unknown">Waiting for predictions</string>
    <plurals name="live_update_stops_away">
        <item quantity="one">%1$d stop away</item>
        <item quantity="other">%1$d stops away</item>
    </plurals>
    <!-- Riding title. Keep the destination (the stop name) last: it may be cut off, the numbers before it must not. -->
    <!-- Stops left to ride, including the destination. -->
    <plurals name="live_update_stops_to">
        <item quantity="one">%1$d stop to %2$s</item>
        <item quantity="other">%1$d stops to %2$s</item>
    </plurals>
    <string name="live_update_next_stop_to">Next stop: %1$s</string>
    <!-- A time ("12 min" or "10:45 PM") and the destination. -->
    <string name="live_update_time_to">%1$s to %2$s</string>
    <!-- Second line while riding. -->
    <string name="live_update_next">Next: %1$s</string>
    <string name="live_update_at_stop_eta">%1$s · ETA %2$s</string>

    <string name="live_update_sub_eta">ETA %1$s</string>
    <string name="live_update_sub_arrive">Arrive %1$s</string>
    <string name="live_update_ride_minutes">%1$d min ride</string>
    <string name="live_update_ride_hours">%1$d hr %2$d min ride</string>

    <string name="live_update_chip_boarding">Board</string>
    <string name="live_update_chip_arriving">Now</string>
    <string name="live_update_chip_minutes">%1$d min</string>
    <plurals name="live_update_chip_stops">
        <item quantity="one">%1$d stop</item>
        <item quantity="other">%1$d stops</item>
    </plurals>

    <string name="live_update_finished_arrived">Arrived at %1$s</string>
    <string name="live_update_finished_departed">Left %1$s</string>
    <string name="live_update_finished_trip_ended">Trip complete</string>
    <string name="live_update_finished_cancelled">Trip cancelled at %1$s</string>
    <string name="live_update_finished_already_passed">Already past %1$s</string>
    <string name="live_update_finished_no_data">No data for this trip</string>
    <string name="live_update_finished_lost_connection">Lost connection to this trip</string>
    <string name="live_update_finished_max_duration">Stopped tracking after 3 hours</string>

    <!-- Shown when Android ended trip tracking in the background. -->
    <string name="live_update_resume_title">Trip tracking paused</string>
    <string name="live_update_resume_text">Tap to resume tracking</string>

    <string name="live_update_action_stop">Stop</string>

    <string name="live_update_overlay_destination">To %1$s</string>
    <string name="live_update_overlay_choose_destination">Choose destination</string>
    <string name="live_update_overlay_return">Return to trip tracking</string>
    <string name="live_update_overlay_track">Track this trip</string>
    <!-- Read by screen readers while trip tracking starts. -->
    <string name="live_update_overlay_starting">Starting trip tracking</string>
    <string name="live_update_sheet_title">Choose destination</string>
    <string name="live_update_sheet_subtitle">%1$s to %2$s · from %3$s</string>
    <string name="live_update_sheet_no_destination">No destination</string>
    <string name="live_update_sheet_no_destination_detail">End the live update when the vehicle leaves %1$s</string>
    <string name="live_update_sheet_stop">Stop tracking</string>
    <string name="live_update_sheet_enable">Turn on Live Updates in settings</string>
    <string name="live_update_sheet_loading">Loading stops…</string>
</resources>
